+/* ---- 명령어 트레이서 (SS1 세션 추가) ---- */
+#include "TLCS900h_registers.h"
+static uint32 dbg_ilo = 0, dbg_ihi = 0;
+#define DBG_IMAX 65536
+static uint32 dbg_ilog[DBG_IMAX][10];
+static uint32 dbg_ilog_n = 0;
+void retro_dbg_iwatch(uint32 lo, uint32 hi) { dbg_ilo = lo; dbg_ihi = hi; dbg_ilog_n = 0; }
+uint32 retro_dbg_ilog_count(void) { return dbg_ilog_n; }
+uint32 retro_dbg_ilog_get(uint32 i, uint32 f) { return (i < dbg_ilog_n && f < 10) ? dbg_ilog[i][f] : 0; }
+static void dbg_itrace(void)
+{
+   if (dbg_ihi && pc >= dbg_ilo && pc < dbg_ihi && dbg_ilog_n < DBG_IMAX)
+   {
+      uint32 *e = dbg_ilog[dbg_ilog_n++];
+      e[0] = pc;
+      e[1] = gprBank[statusRFP][0]; e[2] = gprBank[statusRFP][1];
+      e[3] = gprBank[statusRFP][2]; e[4] = gprBank[statusRFP][3];
+      e[5] = gpr[0]; e[6] = gpr[1]; e[7] = gpr[2]; e[8] = gpr[3];
+      e[9] = 0;
+   }
+}
